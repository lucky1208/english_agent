# ── Alibaba Cloud Bailian: text model ─────────────────────────────────────────
# Use an API key and endpoints from the SAME region and workspace.
# Public Beijing endpoint (simple, but workspace endpoints are recommended):
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus

# ── Qwen-Audio-Realtime over WebRTC ──────────────────────────────────────────
# Set the SDP endpoint exactly as shown in the current Bailian docs, WITHOUT ?model=.
# Pattern: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/webrtc/realtime
DASHSCOPE_REALTIME_URL=
DASHSCOPE_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
DASHSCOPE_REALTIME_VOICE=longanqian_v3.1

# ── Bailian long-term memory (optional) ──────────────────────────────────────
# Pattern: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v2/apps/memory/
BAILIAN_MEMORY_BASE_URL=
BAILIAN_MEMORY_API_KEY=
BAILIAN_MEMORY_PROJECT_ID=english-ai-tutor
BAILIAN_MEMORY_LIBRARY_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase dashboards call this "Publishable key"; older dashboards call it "anon public".
# Use either value here. The app also falls back to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Required only for full auth-account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional fixed account (personal / single-user mode) ─────────────────────
# Create this user in Supabase Auth > Users first. Server-only; never NEXT_PUBLIC_.
# If these are set, the app auto-signs into this account and the login UI stays disabled.
FIXED_ACCOUNT_EMAIL=
FIXED_ACCOUNT_PASSWORD=
# Required in production when a fixed account is configured. Use a long random string.
# The browser asks for it once per session, then stores it in sessionStorage.
FIXED_ACCOUNT_ACCESS_CODE=

# ── Upstash Redis rate limiting (required in production) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Product ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000